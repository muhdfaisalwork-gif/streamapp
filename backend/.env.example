# Backend environment template - copy to .env to override defaults
PORT=3000

# CORS origin(s) for the Flutter web/desktop clients during local development
CORS_ORIGIN=*

# Default sources enabled at startup (comma-separated).
# Built-in sources always available: MovieBox, LegalCatalog, ScrapyFeed
# Per-site Playwright scrapers (opt-in, see AggregatorScraper.js):
#   BeeTV, MovieBoxHD, OnStream, HDOBox, 123Movies, YTS, YifyPro, TMovies, Donkey, UFlix
# Example: MovieBox,BeeTV,MovieBoxHD,YTS,LegalCatalog
ENABLED_SOURCES=MovieBox,LegalCatalog

# Path to the SQLite database file (uses node:sqlite built into Node 22+)
DB_PATH=./streaming_app.db

# TMDB API key (optional). When set, CatalogEnricher fills missing metadata
# (real episode titles, vote counts, runtime) and replaces synthetic TV episodes
# with actual TMDB data. Get a free key at https://www.themoviedb.org/settings/api
# Leave empty to fall back to the hand-curated catalog.
TMDB_API_KEY=

# Path to Scrapy service output (Phase 1b). Reads scraped_catalog.json
# if present and <24h old. Leave default unless you customized the scraper.
SCRAPY_FEED_PATH=../scraper/output/scraped_catalog.json
